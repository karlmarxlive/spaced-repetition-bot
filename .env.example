# Только для бота. Пустое значение не мешает Django и тестам.
TELEGRAM_BOT_TOKEN=
# Замените локально случайной строкой; не публикуйте секрет.
DJANGO_SECRET_KEY=replace-with-a-random-local-secret
# true/false; по умолчанию true для локальной разработки.
DJANGO_DEBUG=true
# Имена хостов через запятую, без схемы и порта.
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1,[::1]
